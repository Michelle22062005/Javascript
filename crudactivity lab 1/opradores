//operadores aritmeticos
let a = 10;
let b = 3;

a + b; // 13  (suma)
a - b; // 7   (resta)
a * b; // 30  (multiplicación)
a / b; // 3.33 (división)
a % b; // 1   (módulo / residuo)
a ** b; // 1000 (potencia)

//OPERADORES DE ASIGNACION
let x = 5;

x = 10;
x += 3;  // x = x + 3 → 13
x -= 2;  // 11
x *= 2;  // 22
x /= 2;  // 11

//OPERADORES DE COMPARACION
5 == '5';   // true  (compara valor)
5 === '5';  // false (compara valor y tipo)
5 != '5';   // false
5 !== '5';  // true
5 > 3;      // true
5 < 3;      // false
5 >= 5;     // true
5 <= 4;     // false

//OPERADORES LOGICOS
true && false; // false (AND)
true || false; // true  (OR)
!true;         // false (NOT)
//ejemplo
let edad = 20;
let tieneCedula = true;

edad >= 18 && tieneCedula; // true

